# Built binary
/dmarc-monitor

# Credentials. The real file lives in ~/.local/share/dmarc-monitor/, never in
# the repository -- but a stray copy here would be one `git add -A` away from
# being published, so refuse it by name as well.
credentials.env
*.credentials
.env
.env.local

# Local, per-machine working area
local/
*.tmp

# secrets.env holds the deploy key and the production mailbox password; it
# lives in Bitwarden. secrets.env.example is the committed template.
secrets.env
secrets.env.bak

# make release-build
/dmarc-monitor-linux-amd64
