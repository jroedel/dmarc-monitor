# Every credential and address this project needs, in one file.
#
# Copy to secrets.env, fill it in, and keep that copy in Bitwarden.
# secrets.env is gitignored and must never be committed. It holds the deploy
# key, base64-encoded -- encoded, not encrypted -- so it is exactly as
# sensitive as the key, and it holds the production mailbox password.
#
# The groups go to different places, and which group a value is in is a
# security decision, not a filing convenience:
#
#   DEPLOY_*   -> GitHub Actions *secrets*. CI needs them to reach the server.
#   APP_*      -> GitHub Actions *variables*. Not secret; a path and a count.
#   RUNTIME    -> the server's credentials.env, over ssh, from your machine
#                 only. Never GitHub: the repository is public, and so are
#                 its Actions logs.
#   DEV_*      -> ~/.local/share/dmarc-monitor/credentials.env on this
#                 machine, for `make run` and `make check`. Never leaves it.
#
# In order, for a first setup or after a key is rotated:
#
#   make deploy-keygen          mint the key; install its public half on konsoleH
#   make deploy-known-hosts     pin the server's host key
#   make deploy-send-secrets    GitHub secrets and variables, and credentials.env
#   make deploy-status          is everything in place? says what is not
#   make local-credentials      the DEV_* group, for development
#
# Quoting: a value is taken as written. Wrap it in "..." or '...' if it has
# spaces at either end or a space followed by #; otherwise no quotes needed.


# ---------------------------------------------------------------------------
# DEPLOY: how to reach the konsoleH account. Becomes GitHub secrets.
# ---------------------------------------------------------------------------

# The same account as stewards and mass-intentions, so the same host and user.
# The key is this project's own: see make deploy-keygen.
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=
DEPLOY_SSH_PORT=22

# Paste the line make deploy-keygen prints.
DEPLOY_SSH_KEY_B64=

# Paste the line make deploy-known-hosts prints, after comparing the
# fingerprint with what konsoleH shows.
DEPLOY_KNOWN_HOSTS_B64=


# ---------------------------------------------------------------------------
# APP: where it lives. Becomes GitHub variables. Not secret.
# ---------------------------------------------------------------------------

# The installation directory, relative to the account's home: the binary,
# credentials.env, state.json and cron.log. Must be outside public_html.
# The crontab line and every make prod-* target are found from it.
APP_DIR=dmarc-monitor

# How many copies of state.json to keep. One is taken on every deploy, before
# the binary is swapped; state.json is what stops a redeploy re-alerting on
# every report it has already seen.
KEEP_BACKUPS=14


# ---------------------------------------------------------------------------
# RUNTIME: rendered into the server's credentials.env. NEVER sent to GitHub.
# ---------------------------------------------------------------------------
#
# The same keys, with the same meanings and defaults, as the annotated template
# the binary writes (dmarc-monitor -init-credentials); read that for what each
# one does. An empty key here is left out of credentials.env, so the binary's
# default applies.
#
# ALERT_FLOOR and the TRIAGE_* thresholds decide who gets woken up. Leave them
# empty unless that has been agreed.

IMAP_HOST=
IMAP_PORT=
IMAP_SECURITY=
IMAP_MAILBOX=
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MARK_SEEN=
IMAP_MOVE_TO=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=

ALERT_FROM=
# Comma-separated for more than one.
ALERT_TO=
ALERT_SUBJECT_PREFIX=
ALERT_FLOOR=
ALERT_COOLDOWN=
ALERT_ON_UPDATE=

TRIAGE_FAILURE_RATE=
TRIAGE_MIN_VOLUME=
TRIAGE_NEW_SOURCE_VOLUME=

POLL_INTERVAL=

# The local model has nothing to talk to on konsoleH; leave these empty there.
LLM_ENABLED=
LLM_ENDPOINT=
LLM_MODEL=
LLM_TIMEOUT=


# ---------------------------------------------------------------------------
# DEV: this machine only. Read by make local-credentials, never sent anywhere.
# ---------------------------------------------------------------------------
#
# The disposable test mailbox -- the one AGENTS.md lets an agent connect to.
# Every RUNTIME key above can be given here with a DEV_ prefix; the same rules
# apply. Never the production mailbox: an agent may run `make check` and
# `make run` against whatever these name.

DEV_IMAP_HOST=
DEV_IMAP_USERNAME=
DEV_IMAP_PASSWORD=

DEV_SMTP_HOST=
DEV_SMTP_USERNAME=
DEV_SMTP_PASSWORD=

DEV_ALERT_FROM=
DEV_ALERT_TO=
