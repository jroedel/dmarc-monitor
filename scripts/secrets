#!/usr/bin/env bash
#
# One credentials file, four destinations. Adapted from stewards' script of the
# same name, which took it from mass-intentions; cut down to what this project
# has (no web front end, no database) and grown by one group, DEV_*, because
# here the development mailbox is a real account too.
#
# secrets.env holds everything this project needs. Which group a value is in
# decides where it goes, and that is a security decision rather than a filing
# one:
#
#   DEPLOY_*  -> GitHub Actions secrets. CI needs them to reach the server.
#   APP_*     -> GitHub Actions variables. A path and a count; not secret.
#   runtime   -> the server's credentials.env, over ssh, from a person's machine.
#   DEV_*     -> this machine's credentials.env, for development.
#
# The runtime group never passes through GitHub. The repository is public, and
# a secret CI holds is a secret one bad workflow change can print.
#
# Run by a person, never by an agent (AGENTS.md). Every command that reads the
# real secrets.env is reached through a `make deploy-*` target or `make
# local-credentials`, and .claude/settings.json denies both those and this
# script to agents.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SECRETS_ENV="${SECRETS_ENV:-$REPO_DIR/secrets.env}"

APP=dmarc-monitor

log()  { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33m !!\033[0m %s\n' "$*" >&2; }
ok()   { printf '\033[32m  ok\033[0m %s\n' "$*"; }
bad()  { printf '\033[31m   X\033[0m %s\n' "$*"; }
die()  { printf '\033[31mX\033[0m %s\n' "$*" >&2; exit 1; }

require() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but is not installed"; }

# Which key belongs to which destination. This list IS the policy, so it is
# written out rather than inferred from a prefix -- a new secret added to
# secrets.env and not named here goes nowhere, loudly, which is the safe
# direction to fail.
DEPLOY_KEYS=(DEPLOY_SSH_HOST DEPLOY_SSH_USER DEPLOY_SSH_PORT DEPLOY_SSH_KEY_B64 DEPLOY_KNOWN_HOSTS_B64)
VAR_KEYS=(APP_DIR KEEP_BACKUPS)

# Every key the binary's credentials file accepts, in the template's order.
# The binary refuses a key it does not know, so this list and the `known` map
# in foundation/config/build.go must agree; scripts/secrets-test.sh holds them
# together.
RUNTIME_KEYS=(
	IMAP_HOST IMAP_PORT IMAP_SECURITY IMAP_MAILBOX IMAP_USERNAME IMAP_PASSWORD IMAP_MARK_SEEN IMAP_MOVE_TO
	SMTP_HOST SMTP_PORT SMTP_SECURITY SMTP_USERNAME SMTP_PASSWORD
	ALERT_FROM ALERT_TO ALERT_SUBJECT_PREFIX ALERT_FLOOR ALERT_COOLDOWN ALERT_ON_UPDATE
	TRIAGE_FAILURE_RATE TRIAGE_MIN_VOLUME TRIAGE_NEW_SOURCE_VOLUME
	POLL_INTERVAL
	LLM_ENABLED LLM_ENDPOINT LLM_MODEL LLM_TIMEOUT
)

# The six with no default. The binary refuses to start without them.
RUNTIME_REQUIRED=(IMAP_USERNAME IMAP_PASSWORD SMTP_USERNAME SMTP_PASSWORD ALERT_FROM ALERT_TO)

REQUIRED=(DEPLOY_SSH_HOST DEPLOY_SSH_USER DEPLOY_SSH_PORT DEPLOY_SSH_KEY_B64 DEPLOY_KNOWN_HOSTS_B64 APP_DIR)

# shellcheck source=env.sh
. "$REPO_DIR/scripts/env.sh"

load() {
	[ -f "$SECRETS_ENV" ] || die "there is no $SECRETS_ENV. Copy secrets.env.example to secrets.env and fill it in"
	parse_env "$SECRETS_ENV"
}

b64()   { base64 -w0 2>/dev/null || base64 | tr -d '\n'; }
unb64() { base64 -d 2>/dev/null; }

# The deploy key and the pinned host key live in secrets.env, base64-encoded on
# one line each, because a private key is multi-line and this file is
# line-oriented. Encoded, not encrypted: secrets.env is exactly as sensitive as
# the key itself, and lives in Bitwarden for that reason.
#
# materialise decodes both into a directory removed on exit, so nothing is left
# on disk between commands. The directory and its trap are made here, at the
# top level: materialise is reached through $(keyfile), a subshell, and a trap
# set in a subshell fires at its closing parenthesis.
SECRETS_TMP="$(mktemp -d)"
chmod 700 "$SECRETS_TMP"
trap 'rm -rf "$SECRETS_TMP"' EXIT

# materialise reports and returns rather than dying, because status exists to
# tell somebody everything that is wrong, not the first thing.
materialise() {
	[ ! -s "$SECRETS_TMP/key" ] || return 0

	if [ -z "${DEPLOY_SSH_KEY_B64:-}" ]; then
		bad "DEPLOY_SSH_KEY_B64 is not set. Run: make deploy-keygen" >&2
		return 1
	fi

	if ! printf '%s' "$DEPLOY_SSH_KEY_B64" | unb64 > "$SECRETS_TMP/key"; then
		bad "DEPLOY_SSH_KEY_B64 is not valid base64. Re-run: make deploy-keygen" >&2
		return 1
	fi
	chmod 600 "$SECRETS_TMP/key"

	if ! grep -q 'BEGIN OPENSSH PRIVATE KEY' "$SECRETS_TMP/key"; then
		bad "DEPLOY_SSH_KEY_B64 decodes to something that is not an ssh private key. Re-run: make deploy-keygen" >&2
		return 1
	fi

	if [ -n "${DEPLOY_KNOWN_HOSTS_B64:-}" ]; then
		if ! printf '%s' "$DEPLOY_KNOWN_HOSTS_B64" | unb64 > "$SECRETS_TMP/known_hosts"; then
			bad "DEPLOY_KNOWN_HOSTS_B64 is not valid base64. Re-run: make deploy-known-hosts" >&2
			return 1
		fi
	else
		: > "$SECRETS_TMP/known_hosts"
	fi

	return 0
}

keyfile()    { printf '%s' "$SECRETS_TMP/key"; }
knownhosts() { printf '%s' "$SECRETS_TMP/known_hosts"; }

# remote runs one command on the server with the pinned host key, the deploy
# key and nothing else: BatchMode so a key that is not installed is a failure
# rather than a password prompt.
remote() {
	ssh -i "$(keyfile)" -p "${DEPLOY_SSH_PORT:-22}" \
		-o "UserKnownHostsFile=$(knownhosts)" -o StrictHostKeyChecking=yes \
		-o BatchMode=yes -o ConnectTimeout=15 \
		"${DEPLOY_SSH_USER}@${DEPLOY_SSH_HOST}" "$@"
}

# Variables are not secret, so a mismatch can show both sides -- and has to,
# because the difference is usually one that cannot be seen: a space, a
# carriage return. %q makes it visible. Never used on a secret value.
shown()      { printf '%q' "$1"; }
live_value() { sed -n "s/^$1=//p" <<<"$2" | head -1; }

# ---------------------------------------------------------------- render

# quoted writes a value so the binary reads back exactly what secrets.env held.
#
# Always quoted, never bare. The binary strips a trailing " # comment" from an
# unquoted value, so a password containing " #" would be cut short without a
# word -- and a rule of "quote only when needed" is a rule that has to be right
# about every password ever pasted in. Quoted, the value is everything between
# the first quote and the next one of the same kind, so either kind will do as
# long as the value does not contain it. A value containing both cannot be
# written in that format at all, and is refused rather than mangled.
quoted() {
	local key="$1" value="$2"

	case "$value" in
	*'"'*"'"*|*"'"*'"'*) die "$key contains both a ' and a \"; credentials.env has no way to write that. Change the password" ;;
	*'"'*) printf "'%s'" "$value" ;;
	*)     printf '"%s"' "$value" ;;
	esac
}

# cmd_render prints a credentials.env: production from the runtime group, local
# from DEV_*. Keys that are empty are left out, so the binary's default
# applies -- an empty line in the file would mean the same thing, but invites
# somebody to fill it in on the server, where the next deploy-send-secrets
# discards it.
cmd_render() {
	local env="${1:-production}" prefix
	load

	case "$env" in
	production) prefix="" ;;
	local)      prefix="DEV_" ;;
	*)          die "render takes production or local, not $env" ;;
	esac

	local key name
	for key in "${RUNTIME_REQUIRED[@]}"; do
		name="$prefix$key"
		[ -n "${!name:-}" ] || die "$name is empty in secrets.env; the binary will not start without it"
	done

	cat <<-HEAD
		# Written by scripts/secrets. Do not edit by hand: the next
		# make $([ "$env" = production ] && echo deploy-send-secrets || echo local-credentials) overwrites it, and the edit is lost.
		#
		# Source of truth is secrets.env on a person's machine, which is in
		# Bitwarden. Change it there and run that again.
		#
		# What each key means: dmarc-monitor -init-credentials writes the
		# annotated template, to a path of your choosing with -credentials.

	HEAD

	local value line
	for key in "${RUNTIME_KEYS[@]}"; do
		name="$prefix$key"
		value="${!name:-}"
		[ -n "$value" ] || continue

		line="$(quoted "$name" "$value")"
		printf '%s=%s\n' "$key" "$line"
	done
}

# ---------------------------------------------------------------- local

# local_path is where the binary looks for credentials when it is run with
# `go run`, which builds into a temporary directory and so has nothing
# "beside" it: the XDG fallback in foundation/apppath.
local_path() {
	printf '%s/dmarc-monitor/credentials.env' "${XDG_DATA_HOME:-$HOME/.local/share}"
}

# cmd_local writes this machine's credentials.env from DEV_*. Through a .new
# file and a rename, at 0600 from the start, and keeping whatever was there as
# .prev -- the first run of this replaces a file written by hand, which may
# hold the only copy of the test mailbox's password.
cmd_local() {
	load

	local path; path="$(local_path)"
	local rendered; rendered="$(cmd_render local)"

	mkdir -p "$(dirname "$path")"
	chmod 700 "$(dirname "$path")"

	( umask 077 && printf '%s\n' "$rendered" > "$path.new" )

	if [ -f "$path" ]; then
		if cmp -s "$path" "$path.new"; then
			rm -f "$path.new"
			ok "$path is already what secrets.env says"
			return 0
		fi
		cp -p "$path" "$path.prev"
		warn "kept the previous file as $path.prev; delete it once make check passes"
	fi

	mv "$path.new" "$path"
	ok "wrote $path. Then: make check"
}

# ---------------------------------------------------------------- ssh key

# cmd_ssh_keygen mints the key this project deploys with.
#
# Its own key, not the person's and not stewards'. The projects deploy to the
# same konsoleH account, so the keys open the same door; a key each is still
# worth it, because revoking one project's key -- a leaked secret, a retired
# repository -- must not break the others' deploys.
#
# ed25519, no passphrase: a passphrase on a key CI must use unattended is a
# passphrase stored next to the key. The private key is never written anywhere
# but a temporary directory this function removes; it exists afterwards only in
# the line printed for secrets.env.
cmd_ssh_keygen() {
	require ssh-keygen
	if [ -f "$SECRETS_ENV" ]; then load; fi

	local tmp; tmp="$(mktemp -d)"
	# shellcheck disable=SC2064 # expanded now, deliberately: $tmp is local
	trap "rm -rf '$tmp'" RETURN

	ssh-keygen -q -t ed25519 -f "$tmp/key" -C "$APP deploy" -N ""

	log "install this public key on the konsoleH account"
	echo
	cat "$tmp/key.pub"
	echo
	log "then put this line in secrets.env, replacing any DEPLOY_SSH_KEY_B64 already there"
	echo
	printf 'DEPLOY_SSH_KEY_B64=%s\n' "$(b64 < "$tmp/key")"
	echo

	cat <<-NEXT
	    Paste the public key into konsoleH's SSH key settings, or, if you can
	    already reach the account another way:

	        ssh-copy-id -f -i /dev/stdin -p "${DEPLOY_SSH_PORT:-22}" "${DEPLOY_SSH_USER:-USER}@${DEPLOY_SSH_HOST:-HOST}" <<'KEY'
	$(cat "$tmp/key.pub")
	KEY

	    Losing this terminal before saving the line above means minting a new
	    key, which is the right cost for the only copy.

	    Then:

	        make deploy-known-hosts     # pin the server
	        make deploy-status          # see what is still missing

	NEXT
}

# ---------------------------------------------------------------- known-hosts

# cmd_known_hosts fetches the server's host key so that a deploy is pinned to
# one machine rather than to whoever answers DNS that morning.
cmd_known_hosts() {
	load
	require ssh-keyscan

	local host="${DEPLOY_SSH_HOST:?DEPLOY_SSH_HOST is not set}"
	local port="${DEPLOY_SSH_PORT:-22}"

	log "asking $host:$port for its host key"

	local keys
	keys="$(ssh-keyscan -p "$port" -t ed25519,rsa "$host" 2>/dev/null | grep -v '^#' || true)"
	[ -n "$keys" ] || die "$host:$port did not answer with a host key. Is the hostname right, and is ssh open on that port?"

	echo
	printf '%s\n' "$keys" | sed 's/^/    /'
	echo
	log "put this line in secrets.env, replacing any DEPLOY_KNOWN_HOSTS_B64 already there"
	echo
	printf 'DEPLOY_KNOWN_HOSTS_B64=%s\n' "$(printf '%s\n' "$keys" | b64)"
	echo
	warn "you are trusting this fingerprint. Compare it with what konsoleH shows before you paste it"
}

# ---------------------------------------------------------------- the checks

# Each section counts its own problems into PROBLEMS and never exits, so that
# status can run all of them and give one verdict at the end. A readiness
# report that stops at the first gap is a report somebody runs six times.
PROBLEMS=0
problem() { bad "$*"; PROBLEMS=$((PROBLEMS + 1)); }

section_local() {
	log "secrets.env: deploying"

	local key
	for key in "${REQUIRED[@]}"; do
		if [ -n "${!key:-}" ]; then ok "$key"; else problem "$key is empty"; fi
	done

	# Decoded and inspected, not merely present. The whole point of keeping the
	# key in this file is that it can be checked before a deploy relies on it.
	if materialise 2>/dev/null; then
		local fp
		fp="$(ssh-keygen -y -f "$(keyfile)" 2>/dev/null | ssh-keygen -lf - 2>/dev/null || true)"
		if [ -n "$fp" ]; then
			ok "the deploy key decodes and is usable: $fp"
		else
			problem "DEPLOY_SSH_KEY_B64 decodes but ssh cannot read it as a key. Run: make deploy-keygen"
		fi
	else
		problem "DEPLOY_SSH_KEY_B64 is missing or not valid base64. Run: make deploy-keygen"
	fi

	# The shape is checked, not only the presence. A known_hosts line missing
	# its host field is ignored by ssh, which then fails the deploy with "Host
	# key verification failed" and names neither the file nor the reason.
	local kh; kh="$(knownhosts)"

	if [ ! -s "$kh" ]; then
		problem "DEPLOY_KNOWN_HOSTS_B64 is empty or invalid; a deploy would trust whatever answers. Run: make deploy-known-hosts"
	elif [ "$(awk 'NF && $1 !~ /^#/ {print NF}' "$kh" | sort -u)" != "3" ]; then
		problem "DEPLOY_KNOWN_HOSTS_B64 is not in known_hosts form (host keytype key). Re-run: make deploy-known-hosts"
	else
		# ssh matches on the host as written, so a port that is not 22 must
		# appear as [host]:port or the pin silently never applies.
		local want="${DEPLOY_SSH_HOST:-}"
		[ "${DEPLOY_SSH_PORT:-22}" = "22" ] || want="[${DEPLOY_SSH_HOST:-}]:${DEPLOY_SSH_PORT}"

		if grep -qF "$want " "$kh"; then
			ok "the host key is pinned for $want"
		else
			problem "DEPLOY_KNOWN_HOSTS_B64 pins a different host than $want. Re-run: make deploy-known-hosts"
		fi
	fi

	# credentials.env and state.json live in APP_DIR. Inside the docroot of
	# any of the account's sites, Apache would serve the mailbox password.
	case "${APP_DIR:-}" in
	"") ;;
	/*|*..*) problem "APP_DIR ($APP_DIR) must be a plain path relative to the account's home, such as dmarc-monitor" ;;
	public_html|public_html/*|*/public_html|*/public_html/*)
		problem "APP_DIR ($APP_DIR) is inside public_html, where Apache could serve credentials.env. Put it beside public_html, such as ~/dmarc-monitor"
		;;
	*) ok "APP_DIR ($APP_DIR) is outside public_html" ;;
	esac
}

section_runtime() {
	log "secrets.env: the production mailbox"

	local key
	for key in "${RUNTIME_REQUIRED[@]}"; do
		if [ -n "${!key:-}" ]; then ok "$key"; else problem "$key is empty; the binary will not start without it"; fi
	done

	# Rendered for real and thrown away, so a value the format cannot carry is
	# found here rather than in the middle of deploy-send-secrets.
	if ( cmd_render production >/dev/null ) 2>/dev/null; then
		ok "credentials.env renders"
	else
		problem "credentials.env does not render: run scripts/secrets render production >/dev/null to see why"
	fi
}

section_github() {
	log "GitHub"

	if ! command -v gh >/dev/null 2>&1; then
		problem "gh is not installed, so GitHub cannot be checked from here"
		return
	fi

	if ! gh auth status >/dev/null 2>&1; then
		problem "gh is not logged in; run gh auth login"
		return
	fi

	local have_secrets live_vars key
	have_secrets="$(gh secret list --json name -q '.[].name' 2>/dev/null || true)"
	live_vars="$(gh variable list --json name,value -q '.[] | .name + "=" + .value' 2>/dev/null || true)"

	# A secret's value cannot be read back, so presence is all there is.
	for key in "${DEPLOY_KEYS[@]}"; do
		if grep -qx "$key" <<<"$have_secrets"; then ok "secret $key"; else problem "secret $key is not on GitHub. Run: make deploy-send-secrets"; fi
	done

	# A variable's value CAN be read back, so it is compared rather than
	# counted.
	for key in "${VAR_KEYS[@]}"; do
		[ -n "${!key:-}" ] || continue

		if grep -qxF "$key=${!key}" <<<"$live_vars"; then
			ok "variable $key matches secrets.env"
		elif grep -q "^$key=" <<<"$live_vars"; then
			problem "variable $key differs: secrets.env says $(shown "${!key}"), GitHub has $(shown "$(live_value "$key" "$live_vars")"). If you ran deploy-send-secrets in the last minute, GitHub may still be catching up; otherwise run it"
		else
			problem "variable $key is not on GitHub. Run: make deploy-send-secrets"
		fi
	done

	# The one direction that matters most: the mailbox password must never
	# have reached GitHub, under any name.
	for key in "${RUNTIME_KEYS[@]}"; do
		if grep -qx "$key" <<<"$have_secrets" || grep -q "^$key=" <<<"$live_vars"; then
			problem "$key is on GitHub and must not be. Remove it: gh secret delete $key (or gh variable delete $key)"
		fi
	done
}

# section_server asks the account, over one ssh connection, the facts a deploy
# depends on. One connection rather than one per question: each is a login on
# a shared account, and six of them to answer one question is noise in the
# account's log and in the wait.
section_server() {
	log "the server"

	if [ ! -s "$(keyfile)" ] || [ ! -s "$(knownhosts)" ] || [ -z "${DEPLOY_SSH_HOST:-}" ] || [ -z "${DEPLOY_SSH_USER:-}" ]; then
		problem "cannot try the server until the deploy credentials above are in place"
		return
	fi

	local dir; dir="$(printf '%q' "${APP_DIR:-}")"

	local out
	if ! out="$(remote "
		echo who=\$(id -un)@\$(hostname)
		[ -d $dir ] && echo dir=yes || echo dir=no
		[ -x $dir/$APP ] && echo binary=\$($dir/$APP -version 2>/dev/null | head -1) || echo binary=
		[ -f $dir/credentials.env ] && echo creds=\$(stat -c %a $dir/credentials.env) || echo creds=
		crontab -l 2>/dev/null | grep -c ' # $APP\$' | sed 's/^/cron=/'
		crontab -l 2>/dev/null | grep -c 'releases/latest/download/$APP-' | sed 's/^/legacy=/'
		echo tz=\$(TZ=America/Chicago date +%Z)
	" 2>&1)"; then
		case "$out" in
		*"Host key verification failed"*)
			problem "the pinned host key does not match what answered. Re-run: make deploy-known-hosts" ;;
		*"Permission denied"*)
			problem "the server does not accept the deploy key. Install its public half on the account: make deploy-keygen prints it" ;;
		*)
			problem "could not reach ${DEPLOY_SSH_USER}@${DEPLOY_SSH_HOST}: $(printf '%s' "$out" | tail -1)" ;;
		esac
		return
	fi

	fact() { sed -n "s/^$1=//p" <<<"$out"; }

	ok "the deploy key is accepted: $(fact who)"

	# Not problems: a first deploy creates the directory, the binary and the
	# crontab line. Reported so that "has this ever been deployed?" is on the
	# screen.
	if [ "$(fact dir)" = yes ]; then ok "APP_DIR $APP_DIR exists"
	else warn "APP_DIR $APP_DIR does not exist yet; the first deploy will create it"; fi

	if [ -n "$(fact binary)" ]; then ok "installed: $(fact binary)"
	else warn "no binary installed yet; the first deploy puts it there"; fi

	# The binary refuses to read a credentials file anybody else can, so a
	# wrong mode is a monitor that has stopped, not a style point.
	case "$(fact creds)" in
	600) ok "credentials.env is installed, mode 600" ;;
	"")  problem "credentials.env is not installed in $APP_DIR. Run: make deploy-send-secrets" ;;
	*)   problem "credentials.env is mode $(fact creds); the binary refuses anything but 600. Run: make deploy-send-secrets" ;;
	esac

	case "$(fact cron)" in
	0) warn "the crontab line is not installed yet; the next deploy installs it" ;;
	1) ok "the crontab line is installed" ;;
	*) problem "the crontab has $(fact cron) lines marked # $APP; there should be one. The next deploy rewrites them" ;;
	esac

	if [ "$(fact legacy)" != 0 ]; then
		warn "the old self-updating crontab line is still there; the next deploy removes it"
	fi

	# If tzdata is missing, `date` answers in UTC without a word, and the
	# guard in the crontab line then fires at the wrong two hours a day.
	case "$(fact tz)" in
	CST|CDT) ok "the server resolves America/Chicago ($(fact tz))" ;;
	*)       problem "the server answers $(shown "$(fact tz)") for America/Chicago; without tzdata the schedule runs at the wrong hours" ;;
	esac
}

section_pipeline() {
	log "the deploy pipeline"

	if make -C "$REPO_DIR" --no-print-directory release-build >/dev/null 2>&1; then
		ok "the release binary builds and is static"
		rm -f "$REPO_DIR/$APP-linux-amd64"
	else
		problem "make release-build fails; run it to see why"
	fi

	if [ -e "$REPO_DIR/.github/workflows/deploy.yml" ]; then ok ".github/workflows/deploy.yml"
	else problem ".github/workflows/deploy.yml is missing"; fi
}

verdict() {
	echo
	if [ "$PROBLEMS" -eq 0 ]; then
		log "ready: a push to main will deploy"
	else
		die "not ready: $PROBLEMS problem(s) above"
	fi
}

cmd_status() {
	load
	section_local
	section_runtime
	section_github
	section_server
	section_pipeline
	verdict
}

# ---------------------------------------------------------------- push

cmd_push() {
	load
	require gh

	# Piped to stdin, never `--body -`. gh reads standard input only when
	# --body is absent; `--body -` stores the literal string "-". That shipped
	# once in mass-intentions and put a dash in all ten values while a check
	# passed, because listing secrets returns names and not values.
	set_value() {
		local kind="$1" name="$2" value="$3"

		case "$kind" in
		secret)   printf '%s' "$value" | gh secret set "$name" ;;
		variable) printf '%s' "$value" | gh variable set "$name" ;;
		esac
	}

	# Decoding before sending, so a corrupt value fails here rather than in CI.
	materialise || die "the deploy credentials will not decode; nothing was sent"

	local key
	log "sending the deploy group to GitHub secrets"
	for key in "${DEPLOY_KEYS[@]}"; do
		[ -n "${!key:-}" ] || die "$key is empty; run make deploy-status"
		set_value secret "$key" "${!key}"
		ok "$key"
	done

	log "sending the paths to GitHub variables"
	for key in "${VAR_KEYS[@]}"; do
		if [ -n "${!key:-}" ]; then
			set_value variable "$key" "${!key}"
			ok "$key"
		fi
	done

	# Variables can be read back; secrets cannot. So the half that can be
	# verified is verified, immediately, rather than trusted until a deploy
	# disagrees. Asked again with a growing wait before anything is called a
	# mismatch: GitHub's variable list lags a set by a few seconds.
	log "reading the variables back"

	local live wrong delay=1 attempt
	for attempt in 1 2 3 4 5; do
		live="$(gh variable list --json name,value -q '.[] | .name + "=" + .value' 2>/dev/null || true)"

		wrong=0
		for key in "${VAR_KEYS[@]}"; do
			[ -n "${!key:-}" ] || continue
			grep -qxF "$key=${!key}" <<<"$live" || wrong=$((wrong + 1))
		done

		if [ "$wrong" -eq 0 ] || [ "$attempt" -ge 5 ]; then break; fi

		warn "GitHub has not caught up with $wrong variable(s) yet; asking again in ${delay}s"
		sleep "$delay"
		delay=$((delay * 2))
	done

	for key in "${VAR_KEYS[@]}"; do
		[ -n "${!key:-}" ] || continue
		if grep -qxF "$key=${!key}" <<<"$live"; then
			ok "$key is what we sent"
		else
			bad "$key came back different: sent $(shown "${!key}"), GitHub has $(shown "$(live_value "$key" "$live")")"
		fi
	done
	[ "$wrong" -eq 0 ] || die "$wrong variable(s) still differ after waiting for GitHub to catch up"
}

# ---------------------------------------------------------------- install

# cmd_install writes credentials.env onto the server. Through a .new file and a
# rename, so a run that starts meanwhile never reads half a file, and created
# 0600 from the start, so there is no moment it is readable by anyone else.
#
# And only if the binary on the server accepts it and can log in with it. The
# binary refuses a key it does not know, and a password that is wrong is a
# monitor that fails twice a day from then on; -check catches both, from the
# server, and sends nothing. On a first install there is no binary yet, and
# nothing to ask. INSTALL_WITHOUT_CHECK=1 skips it, for a mailbox that does not
# exist yet.
#
# Whatever was there before is kept as credentials.env.prev. The first run of
# this replaces a file written by hand on the server, which may hold values
# secrets.env was never given.
cmd_install() {
	load
	require ssh

	materialise || die "the deploy credentials will not decode. Run: make deploy-status"
	[ -s "$(knownhosts)" ] || die "DEPLOY_KNOWN_HOSTS_B64 is empty; run make deploy-known-hosts first"

	local dir="${APP_DIR:?APP_DIR is not set}"
	local q; q="$(printf '%q' "$dir")"
	local check=1
	[ -z "${INSTALL_WITHOUT_CHECK:-}" ] || check=0

	log "writing $dir/credentials.env on ${DEPLOY_SSH_HOST}"

	local rendered; rendered="$(cmd_render production)"

	printf '%s\n' "$rendered" | remote "
		mkdir -p $q && chmod 700 $q && cd $q &&
		( umask 077 && cat > credentials.env.new ) &&
		if [ $check = 1 ] && [ -x ./$APP ] && ! ./$APP -credentials credentials.env.new -check; then
			rm -f credentials.env.new
			exit 3
		fi &&
		{ [ ! -f credentials.env ] || cp -p credentials.env credentials.env.prev; } &&
		mv credentials.env.new credentials.env" \
	|| die "the binary on the server refused the new credentials.env (its reason is above), so the old one is still in place"

	ok "installed. The next scheduled run uses it; make prod-check tries it now"
}

# ---------------------------------------------------------------- dispatch

usage() {
	cat <<-USAGE
		usage: scripts/secrets <command>

		  status       is everything in place to deploy? secrets.env, GitHub,
		               the server and the pipeline
		  push         send the deploy group and the paths to GitHub
		  install      write credentials.env onto the server
		  local        write this machine's credentials.env from DEV_*
		  render [production|local]
		               print a credentials.env, write nothing
		  ssh-keygen   mint the deploy key and print how to install it
		  known-hosts  fetch the server's host key for pinning
	USAGE
}

case "${1:-}" in
status)      shift; cmd_status "$@" ;;
push)        shift; cmd_push "$@" ;;
install)     shift; cmd_install "$@" ;;
local)       shift; cmd_local "$@" ;;
render)      shift; cmd_render "$@" ;;
ssh-keygen)  shift; cmd_ssh_keygen "$@" ;;
known-hosts) shift; cmd_known_hosts "$@" ;;
*)           usage; exit 2 ;;
esac
